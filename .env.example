# ---- Global environment template ----
# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Backend
BACKEND_PORT=8000
SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=insightai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=insightai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://insightai_user:InsightAI_Local_2026@localhost:5432/insightai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=insightai-datasets

# LLM provider
ANTHROPIC_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
